# Copie para .env antes de rodar o servidor.
PORT=4000
# Gere um valor real, não use este texto: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio
# Caminho do arquivo SQLite (criado automaticamente se não existir).
DB_PATH=./data/finance.sqlite
# Origem do frontend liberada no CORS (Vite roda em 5173 por padrão).
CORS_ORIGIN=http://localhost:5173
